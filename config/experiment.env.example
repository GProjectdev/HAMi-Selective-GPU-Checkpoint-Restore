# Copy to config/experiment.env and fill UNKNOWN values before running mutating steps.
EXPERIMENT_NAMESPACE=hami-selective-cr

BASE_CR_REPO=../K8s-Native-Fast-GPU-Checkpoint-Restore-System
RESTORE_CR_REPO=../K8s-Native-GPU-Restore-CRI-O

SOURCE_NODE=
# Same-Worker restore is the default. Leave TARGET_NODE empty for automatic
# same-node detection, or set it to the same value as SOURCE_NODE.
TARGET_NODE=

# Cross-node readiness / migration artifact staging.
# The first cross-node check copies the latest checkpoint tar/blob from the
# source worker to this NFS export, then verifies that TARGET_NODE can read the
# same files with matching SHA256.
NFS_SERVER=10.178.0.14
NFS_EXPORT_PATH=/mnt/nfs
NFS_ARTIFACT_SUBDIR=gcr_lastmonth/hami-selective-cr
CROSS_NODE_HELPER_IMAGE=nvidia/cuda:12.4.1-devel-ubuntu22.04

GPU_RESOURCE_NAME=nvidia.com/gpu
HAMI_MEMORY_RESOURCE=nvidia.com/gpumem
HAMI_CORE_RESOURCE=nvidia.com/gpucores

POD_A_MEMORY_MB=8192
POD_A_CORE_PERCENT=20
POD_B_MEMORY_MB=8192
POD_B_CORE_PERCENT=20

LOCAL_CHECKPOINT_ROOT=
SHARED_CHECKPOINT_ROOT=

GPU_CR_NAMESPACE=gpu-cr-system
GPU_CR_LIB_HOST_PATH=/var/lib/gpu-cr/lib
GCR_CONTROL_DIR=/var/lib/gpu-cr/run
GCR_DATA_DIR=/var/lib/gcr-data
CHECKPOINT_STORAGE_TYPE=hostPath
CHECKPOINT_STORAGE_PATH=/var/lib/gcr-checkpoint
RESTORE_BLOB_MODE=copy
RESTORE_TIMEOUT_SECONDS=300
REQUIRE_GCR_SELECTIVE_DATA=true
RESTORE_HAMI_VGPU_LOCK_SOURCE=/tmp/vgpulock
RESTORE_HAMI_LD_PRELOAD_SOURCE=/usr/local/vgpu/ld.so.preload
# Empty in the generator/script means:
# /usr/local/vgpu/containers/<checkpoint-source-pod-uid>_selective-target
RESTORE_HAMI_VGPU_DIR_SOURCE=
RESTORE_HAMI_LIBVGPU_SOURCE=/usr/local/vgpu/libvgpu.so.v2.9.0

GCR_LIBRARY_PATH=/var/lib/gpu-cr/lib/libgcr-interceptor.so
CUDA_CHECKPOINT_BIN=
CRIU_BIN=criu
CRIUGPU_PATH=

CONTAINER_RUNTIME=crio

RESULT_ROOT=./results
BACKUP_ROOT=./backups
STATE_ROOT=./.state

# Default mode needs no custom workload image registry. The Pod uses this
# public CUDA devel image and compiles the repo-provided CUDA source from a
# ConfigMap at startup.
WORKLOAD_BASE_IMAGE=nvidia/cuda:12.4.1-devel-ubuntu22.04

# Inference checkpoint-overhead benchmark.
# The model files are expected under ${MODEL_NFS_EXPORT_PATH}/models.
MODEL_NFS_SERVER=10.178.0.14
MODEL_NFS_EXPORT_PATH=/mnt/nfs
INFERENCE_IMAGE=pytorch/pytorch:2.4.1-cuda12.4-cudnn9-runtime
INFERENCE_PIP_INSTALL=false
INFERENCE_MAX_NEW_TOKENS=24
INFERENCE_SLEEP_SECONDS=0.2
INFERENCE_READY_TIMEOUT_SECONDS=900
GPT2_MODEL_ID=gpt2
GPT2_MODEL_RELATIVE_PATH=gpt2
GPT2_GPU_MEMORY_MB=8192
GPT2_GPU_CORE_PERCENT=40
OPT13B_MODEL_ID=facebook/opt-1.3b
OPT13B_MODEL_RELATIVE_PATH=facebook/opt-1.3b
OPT13B_GPU_MEMORY_MB=24576
OPT13B_GPU_CORE_PERCENT=70

# Optional legacy image mode. Leave these empty unless you want to build and
# push custom workload images with scripts/04-build-test-images.sh.
IMAGE_REGISTRY=
TARGET_IMAGE=
CO_RUNNER_IMAGE=

HAMI_VERSION=
HAMI_HELM_REPOSITORY=https://project-hami.github.io/HAMi/
HAMI_HELM_CHART=hami-charts/hami
