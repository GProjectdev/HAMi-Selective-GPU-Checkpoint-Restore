# Copy to config/experiment.env and fill UNKNOWN values before running mutating steps.
EXPERIMENT_NAMESPACE=hami-selective-cr

BASE_CR_REPO=../K8s-Native-Fast-GPU-Checkpoint-Restore-System
RESTORE_CR_REPO=../K8s-Native-GPU-Restore-CRI-O

SOURCE_NODE=
# Same-Worker restore is the default. Leave TARGET_NODE empty for automatic
# same-node detection, or set it to the same value as SOURCE_NODE.
TARGET_NODE=

GPU_RESOURCE_NAME=nvidia.com/gpu
HAMI_MEMORY_RESOURCE=nvidia.com/gpumem
HAMI_CORE_RESOURCE=nvidia.com/gpucores

POD_A_MEMORY_MB=8192
POD_A_CORE_PERCENT=20
POD_B_MEMORY_MB=8192
POD_B_CORE_PERCENT=20

LOCAL_CHECKPOINT_ROOT=
SHARED_CHECKPOINT_ROOT=

GPU_CR_NAMESPACE=gpu-cr-system
GPU_CR_LIB_HOST_PATH=/var/lib/gpu-cr/lib
GCR_CONTROL_DIR=/var/lib/gpu-cr/run
GCR_DATA_DIR=/var/lib/gcr-data
CHECKPOINT_STORAGE_TYPE=hostPath
CHECKPOINT_STORAGE_PATH=/var/lib/gcr-checkpoint
RESTORE_BLOB_MODE=copy
RESTORE_TIMEOUT_SECONDS=300
REQUIRE_GCR_SELECTIVE_DATA=true

GCR_LIBRARY_PATH=/var/lib/gpu-cr/lib/libgcr-interceptor.so
CUDA_CHECKPOINT_BIN=
CRIU_BIN=criu
CRIUGPU_PATH=

CONTAINER_RUNTIME=crio

RESULT_ROOT=./results
BACKUP_ROOT=./backups
STATE_ROOT=./.state

# Default mode needs no custom workload image registry. The Pod uses this
# public CUDA devel image and compiles the repo-provided CUDA source from a
# ConfigMap at startup.
WORKLOAD_BASE_IMAGE=nvidia/cuda:12.4.1-devel-ubuntu22.04

# Optional legacy image mode. Leave these empty unless you want to build and
# push custom workload images with scripts/04-build-test-images.sh.
IMAGE_REGISTRY=
TARGET_IMAGE=
CO_RUNNER_IMAGE=

HAMI_VERSION=
HAMI_HELM_REPOSITORY=https://project-hami.github.io/HAMi/
HAMI_HELM_CHART=hami-charts/hami
